    {
      "id": 5,
      "type": "stat",
      "title": "에러 수 · 24h",
      "description": "최근 24시간에 기록된 OpenClaw ERROR·FATAL 로그 건수입니다. WARN과 메시지 본문의 error 단어는 제외합니다. 1분마다 수집하며 로그를 읽지 못하거나 최근 로그가 없으면 N/A로 표시합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 3,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(openclaw_log_errors_24h and on(job, instance) (openclaw_log_read_error == 0) and on(job, instance) (up{job=\"infinity-dispatcher-exporter\"} == 1))",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "N/A",
          "color": {
            "mode": "fixed",
            "fixedColor": "#9CA3AF"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "OpenClaw 에러 내용 · 최근 24h",
      "description": "최근 24시간 ERROR·FATAL 중 최신 50개입니다. 발생 시각·레벨·최대 2,000자의 메시지를 표시하며 알려진 토큰·인증정보·이메일 패턴은 마스킹합니다. 원문은 기존 호스트 로그에서 확인할 수 있습니다. 원천을 읽지 못하면 조회 오류를 표시합니다.",
      "gridPos": {
        "x": 3,
        "y": 16,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "openclaw-errors"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://infinity-dispatcher-exporter.monitoring.svc:9102/openclaw/errors",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "errors",
          "columns": [
            {
              "selector": "entry",
              "text": "발생 시각 · 에러 내용",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "filterable": true
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "발생 시각 · 에러 내용",
            "desc": true
          }
        ]
      }
    },
