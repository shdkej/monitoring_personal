    {
      "id": 4,
      "type": "timeseries",
      "title": "네트워크 트래픽",
      "description": "node-exporter · 전체 노드 송수신 합계 (bytes/sec)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|docker.*|br.*\"}[5m]))",
          "range": true,
          "legendFormat": "RX"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|br.*\"}[5m]))",
          "range": true,
          "legendFormat": "TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
