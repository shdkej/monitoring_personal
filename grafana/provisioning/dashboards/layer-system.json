    {
      "id": 5,
      "type": "stat",
      "title": "에러 수 · 24h",
      "description": "최근 24시간에 기록된 OpenClaw ERROR·FATAL 로그 건수입니다. WARN과 메시지 본문의 error 단어는 제외합니다. 1분마다 수집하며 로그를 읽지 못하거나 최근 로그가 없으면 N/A로 표시합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 3,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(openclaw_log_errors_24h and on(job, instance) (openclaw_log_read_error == 0) and on(job, instance) (up{job=\"infinity-dispatcher-exporter\"} == 1))",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "N/A",
          "color": {
            "mode": "fixed",
            "fixedColor": "#9CA3AF"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
