    {
      "id": 4,
      "type": "timeseries",
      "title": "네트워크 트래픽",
      "description": "node-exporter · 전체 노드 송수신 합계 (bytes/sec)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
