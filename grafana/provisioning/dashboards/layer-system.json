    {
      "id": 8,
      "type": "timeseries",
      "title": "AWS 처리량·오류",
      "description": "CloudWatch/YACE · exporter scrape는 up. Lambda 호출·오류 샘플이 NaN이고 DynamoDB throttling series가 없어 현재 N/A. 대상 리소스와 유효한 CloudWatch 데이터 확인 필요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(aws_lambda_invocations_sum)",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(aws_lambda_errors_sum)",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(aws_dynamodb_read_throttle_events_sum) + sum(aws_dynamodb_write_throttle_events_sum)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
