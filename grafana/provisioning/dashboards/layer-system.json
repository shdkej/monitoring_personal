      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|docker.*|br.*\"}[5m]))",
          "range": true,
          "legendFormat": "RX"
