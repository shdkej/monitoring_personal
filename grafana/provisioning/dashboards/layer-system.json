        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|br.*\"}[5m]))",
          "range": true,
          "legendFormat": "TX"
