    {
      "id": 1,
      "type": "stat",
      "title": "S3 사용량·이번 달 요금",
      "description": "관측된 일반 버킷의 저장량·객체 수(일간)와 계정 전체 S3 월 누적 예상 요금(USD)입니다. 유료 사용은 저장·요청·전송량에 따라 과금됩니다. 총 저장량에 따른 고정 속도 제한은 없으며 요청 성능은 prefix·요청 패턴별로 봅니다. 상세 링크에서 버킷별 사용량과 성능 수집 상태를 확인하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(max by (dimension_BucketName, dimension_StorageType) (last_over_time(aws_s3_bucket_size_bytes_average[30m])) >= 0)",
          "legendFormat": "관측 저장량",
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(max by (dimension_BucketName) (last_over_time(aws_s3_number_of_objects_average{dimension_StorageType=\"AllStorageTypes\"}[30m])) >= 0)",
          "legendFormat": "객체 수",
          "range": false,
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(last_over_time(aws_billing_estimated_charges_maximum{dimension_ServiceName=\"AmazonS3\",dimension_Currency=\"USD\"}[30m]))",
          "legendFormat": "이번 달 예상 요금",
          "range": false,
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(count by (dimension_BucketName) (last_over_time(aws_s3_bucket_size_bytes_average[30m]) >= 0))",
          "legendFormat": "관측 버킷",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "N/A",
