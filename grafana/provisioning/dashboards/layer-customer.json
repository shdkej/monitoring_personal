    {
      "id": 5,
      "title": "정책콕 · 첫 방문 유입과 사례 열람",
      "description": "최근 7일간 측정에 동의한 정책콕 첫 방문 브라우저 기준입니다. 공유 링크와 그 외 유입에서 사례 열람·열람 전 이탈·관찰 중으로 이어진 첫 방문 브라우저 수입니다. 첫 방문 후 24시간이 지날 때까지 첫 세션의 사례 열람 기록이 없으면 이탈, 24시간 미경과·미열람이면 관찰 중입니다.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "type": "volkovlabs-echarts-panel",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (metric) (posthog_app_first_visits{scope=\"policycock\",scope=~\"${app:regex}\",metric=~\"sharedActivated|sharedPending|otherActivated|otherPending|sharedDropped|otherDropped\"})",
          "legendFormat": "{{metric}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "getOption": "const selected = context.grafana.replaceVariables('${app:regex}');\nif (!new RegExp('^(?:' + selected + ')$').test('policycock')) {\n  return {title: {text: '정책콕을 선택하면 경로가 표시됩니다', left: 'center', top: 'middle', textStyle: {fontSize: 14}}};\n}\nconst counts = new Map();\nfor (const frame of context.panel.data.series) {\n  for (const field of frame.fields) {\n    if (field.type === 'number' && field.labels?.metric && field.values.length) {\n      counts.set(field.labels.metric, field.values[field.values.length - 1]);\n    }\n  }\n}\nconst cells = ['sharedActivated', 'sharedPending', 'otherActivated', 'otherPending', 'sharedDropped', 'otherDropped'];\nif (cells.some(key => !counts.has(key))) {\n  return {title: {text: '집계 대기 중', left: 'center', top: 'middle'}};\n}\nconst [sa, sp, oa, op, sd, od] = cells.map(key => counts.get(key));\nconst total = sa + sp + oa + op;\nconst dropped = sd + od;\nconst open = sp + op - dropped;\nconst summary = {text: '열람 전 이탈 ' + dropped + '건  ·  관찰 중 ' + open + '건',\n  left: 8, top: 6, textStyle: {fontSize: 14, fontWeight: 'normal'}};\nif (!total) return {title: {...summary, subtext: '측정된 첫 방문 0건'}};\nconst edges = [\n  ['공유 링크', '사례 열람', sa], ['공유 링크', '열람 전 이탈', sd], ['공유 링크', '관찰 중', sp - sd],\n  ['그 외 유입', '사례 열람', oa], ['그 외 유입', '열람 전 이탈', od], ['그 외 유입', '관찰 중', op - od]\n];\nconst links = edges.filter(([, , value]) => value > 0).map(([source, target, value]) => ({source, target, value}));\nconst totals = new Map([['공유 링크', sa + sp], ['그 외 유입', oa + op], ['사례 열람', sa + oa], ['열람 전 이탈', dropped], ['관찰 중', open]]);\nreturn {\n  title: summary,\n  tooltip: {trigger: 'item'},\n  series: [{type: 'sankey', left: 12, right: 110, top: 48, bottom: 24,\n    data: [...totals].filter(([, n]) => n > 0).map(([name]) => ({name})), links,\n    label: {formatter: p => p.name + ' ' + totals.get(p.name) + '건'},\n    lineStyle: {color: 'gradient', opacity: 0.45}, emphasis: {focus: 'adjacency'}}]\n};",
        "renderer": "svg"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
