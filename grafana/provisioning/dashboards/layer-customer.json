    {
      "id": 5,
      "title": "앱별 첫 방문 경로",
      "description": "최근 7일간 측정에 동의한 첫 방문 브라우저 기준입니다. 공유 링크·그 외 유입에서 정책콕은 사례 열람, Virtue는 덕행 저장으로 이어진 경로를 봅니다. 첫 방문 후 24시간이 지나도록 첫 세션의 완료 기록이 없으면 이탈, 그 전이면 관찰 중입니다. 선 굵기는 각 앱 안에서의 비중이며, 앱 간 규모는 첫 방문 건수로 비교합니다.",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "type": "volkovlabs-echarts-panel",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (scope, metric) (posthog_app_first_visits{scope=~\"policycock|Virtue\",scope=~\"${app:regex}\",metric=~\"sharedActivated|sharedPending|otherActivated|otherPending|sharedDropped|otherDropped\"})",
          "legendFormat": "{{scope}} · {{metric}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "getOption": "const selected = new RegExp('^(?:' + context.grafana.replaceVariables('${app:regex}') + ')$');\nconst apps = [\n  {scope: 'policycock', color: '#5794F2', name: '정책콕', action: '사례 열람', drop: '열람 전 이탈'},\n  {scope: 'Virtue', color: '#B39DDB', name: 'Virtue', action: '덕행 저장', drop: '저장 전 이탈'}\n].filter(app => selected.test(app.scope));\nif (!apps.length) {\n  return {title: {text: '정책콕 또는 Virtue를 선택해 주세요', left: 'center', top: 'middle', textStyle: {fontSize: 14}}};\n}\n\nconst counts = new Map();\nfor (const frame of context.panel.data.series) {\n  for (const field of frame.fields) {\n    if (field.type === 'number' && field.labels && field.values.length) {\n      counts.set(field.labels.scope + '/' + field.labels.metric, field.values[field.values.length - 1]);\n    }\n  }\n}\n\nconst title = [];\nconst series = [];\nfor (const [index, app] of apps.entries()) {\n  const left = index * 100 / apps.length;\n  const group = {id: app.scope, left: (left + 1) + '%', top: 0, text: app.name + ' · ' + app.action,\n    textStyle: {fontSize: 15, color: app.color}, subtextStyle: {fontSize: 12}, itemGap: 6};\n  title.push(group);\n  const cells = ['sharedActivated', 'sharedPending', 'otherActivated', 'otherPending', 'sharedDropped', 'otherDropped']\n    .map(metric => counts.get(app.scope + '/' + metric));\n  if (cells.some(value => value === undefined)) {\n    group.subtext = '집계 대기 중';\n    continue;\n  }\n  const [sa, sp, oa, op, sd, od] = cells;\n  const total = sa + sp + oa + op;\n  const dropped = sd + od;\n  const open = sp + op - dropped;\n  group.subtext = '첫 방문 ' + total + '건 · 이탈 ' + dropped + '건 · 관찰 중 ' + open + '건';\n  if (!total) continue;\n\n  const edges = [\n    ['공유 링크', app.action, sa], ['공유 링크', app.drop, sd], ['공유 링크', '관찰 중', sp - sd],\n    ['그 외 유입', app.action, oa], ['그 외 유입', app.drop, od], ['그 외 유입', '관찰 중', op - od]\n  ];\n  const links = edges.filter(([, , value]) => value > 0).map(([source, target, value]) => ({source, target, value}));\n  const totals = new Map([['공유 링크', sa + sp], ['그 외 유입', oa + op], [app.action, sa + oa], [app.drop, dropped], ['관찰 중', open]]);\n  series.push({id: app.scope, name: app.name, type: 'sankey', left: (left + 2) + '%',\n    right: (100 - left - 100 / apps.length + 2) + '%', top: 58, bottom: 12, nodeWidth: 12,\n    data: [...totals].filter(([, n]) => n > 0).map(([name]) => name === '공유 링크' || name === '그 외 유입' ? {name, itemStyle: {color: app.color}} : {name}), links,\n    levels: [{depth: 0, label: {position: 'right'}}, {depth: 1, label: {position: 'left'}}],\n    label: {formatter: p => p.name + '\\n' + totals.get(p.name) + '건'},\n    lineStyle: {color: 'gradient', opacity: 0.4}, emphasis: {focus: 'adjacency'}});\n}\nreturn {title, series, tooltip: {trigger: 'item'}};",
        "renderer": "svg"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
